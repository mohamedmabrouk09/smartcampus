# Configuration de l'API SmartCampus (TP4)
# Copier en .env et adapter les valeurs si nécessaire.

# Port d'écoute HTTP (interne au conteneur)
PORT=8080

# Base de données PostgreSQL (rejoint le service "postgres" par DNS Docker)
DB_URL=jdbc:postgresql://postgres:5432/smartcampus
DB_USER=smartcampus
DB_PASSWORD=smartcampus

# JVM
JAVA_OPTS=-Xms128m -Xmx256m